{
  "expo": {
    "name": "AtuaCourier",
    "slug": "AtuaCourier",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "atuacourier",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true,

      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Atua Courier uses your location to show your position on the map and help manage deliveries.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Atua Courier uses your location in the background while you are online so customers and Atua can track your delivery availability.",
        "UIBackgroundModes": ["location"]
      }
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },

      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.atuainc.atuacourier",

      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],

      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDzVvRkaOM0EzKJDQQ0fztKaTlA8tgjdzY"
        }
      }
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",

      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],

      "expo-video",

      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Atua Courier uses your location in the background while you are online so customers and Atua can track your availability."
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "API_BASE_URL": "https://opusama-web.vercel.app/api",

      "eas": {
        "projectId": "3856e224-1531-41c1-adc9-7c6fae25a7cb"
      },

      "router": {}
    },

    "owner": "atuainc"
  }
}
